# ============================================================
# Copia este archivo a .env.local y llena los valores.
# .env.local esta en .gitignore: NUNCA subas tus llaves al repo.
# ============================================================

# ---------- Obligatorias ----------

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica de tu app (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Marca ----------
NEXT_PUBLIC_BRAND_NAME=Mi Comunidad
NEXT_PUBLIC_BRAND_SHORT=Comunidad
NEXT_PUBLIC_BRAND_TAGLINE=Aprende, comparte y crece con tu comunidad
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@example.com
# Zona horaria por defecto del calendario
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Mexico_City

# ---------- Videollamadas (LiveKit) ----------
# LiveKit Cloud (https://cloud.livekit.io) o tu propio servidor LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_API_URL=https://tu-proyecto.livekit.cloud
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://tu-proyecto.livekit.cloud

# ---------- Opcionales ----------

# Correos con Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@tu-dominio.com
RESEND_FROM_NAME=Mi Comunidad

# Push en la PWA: genera con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@example.com

# Secreto compartido con la base para el webhook de notificaciones
# (genera con `openssl rand -hex 32`; ver README, "Push y correos")
SUPABASE_WEBHOOK_SECRET=

# GIFs en posts y comentarios (https://developers.giphy.com)
NEXT_PUBLIC_GIPHY_API_KEY=

# Video en tu propio host (dominio sin https://). Vacio = solo YouTube/Vimeo/Loom
NEXT_PUBLIC_SELF_VIDEO_HOST=
